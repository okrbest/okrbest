exports[`components/ChannelHeader should render shared view 1`] = `
<div>
  <div
    aria-label="channel header region"
    class="channel-header alt a11y__region"
    data-a11y-sort-order="8"
    data-channelid="channel_id"
    id="channel-header"
    role="banner"
    tabindex="-1"
  >
    <div
      class="flex-parent"
    >
      <div
        class="flex-child"
      >
        <div
          class="channel-header__info"
          id="channelHeaderInfo"
        >
          <div
            class="channel-header__title dropdown"
          >
            <div
              class="channel-header__icons"
            >
              <button
                aria-label="Mute Channel"
                class="channel-header__mute btn btn-icon btn-xs"
                data-testid="channelHeaderBellButton"
                id="toggleMute"
              >
                <i
                  aria-hidden="true"
                  class="icon icon-bell-outline"
                />
              </button>
              <button
                aria-label="View 0 members"
                class="channel-member-stack btn btn-icon btn-xs"
                data-testid="channelMemberStack"
                type="button"
              >
                <span
                  class="channel-member-stack__count"
                  data-testid="channelMemberStack-count"
                >
                  -
                </span>
              </button>
              <div
                class="channel-header__bot-filter"
                style="display: flex; align-items: center; gap: 4px; margin-left: 8px;"
              >
                <input
                  id="channelHeaderBotMessagesCheckbox"
                  type="checkbox"
                />
                <label
                  for="channelHeaderBotMessagesCheckbox"
                  style="margin: 0px; cursor: pointer; font-size: 12px;"
                >
                  봇 메세지
                </label>
              </div>
            </div>
            <div
              class="channel-header__description"
              id="channelHeaderDescription"
            >
              <div
                class="header-description__text"
              >
                <p
                  class="markdown__paragraph-inline"
                >
                  header
