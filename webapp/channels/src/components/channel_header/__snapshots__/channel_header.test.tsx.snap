exports[`components/ChannelHeader should match snapshot with last active display 1`] = `
<div>
  <div
    aria-label="channel header region"
    class="channel-header alt a11y__region"
    data-a11y-sort-order="8"
    data-channelid="channel_id"
    id="channel-header"
    role="banner"
    tabindex="-1"
  >
    <div
      class="flex-parent"
    >
      <div
        class="flex-child"
      >
        <div
          class="channel-header__info"
          id="channelHeaderInfo"
        >
          <div
            class="channel-header__title dropdown"
          >
            <div
              class="channel-header__icons"
            >
              <button
                aria-label="Mute Channel"
                class="channel-header__mute btn btn-icon btn-xs"
                data-testid="channelHeaderBellButton"
                id="toggleMute"
              >
                <i
                  aria-hidden="true"
                  class="icon icon-bell-outline"
                />
              </button>
              <div
                class="channel-header__bot-filter"
                style="display: flex; align-items: center; gap: 4px; margin-left: 8px;"
              >
                <input
                  id="channelHeaderBotMessagesCheckbox"
                  type="checkbox"
                />
                <label
                  for="channelHeaderBotMessagesCheckbox"
                  style="margin: 0px; cursor: pointer; font-size: 12px;"
                >
                  봇 메세지
                </label>
              </div>
            </div>
            <div
              class="channel-header__description"
              id="channelHeaderDescription"
            >
              <span
                class="header-status__text"
              >
                <span
                  class="last-active__text"
                >
                  Active 
                  <time
                    datetime="2021-09-20T14:02:42.846"
                  >
                    September 20, 2021
                  </time>
                </span>
              </span>
              <div
                class="header-description__text"
              >
                <p
                  class="markdown__paragraph-inline"
                >
                  not the bot description
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <button
        aria-label="Open in new window"
        class="btn btn-icon btn-sm PopoutButton channel-header__icon"
        type="button"
      >
        <i
          aria-hidden="true"
          class="icon icon-dock-window"
        />
      </button>
      <button
        aria-label="View Info"
        class="channel-header__icon"
        id="channel-info-btn"
      >
        <i
          class="Icon-clPswv hCFmLO icon-information-outline"
        />
      </button>
    </div>
    <div
      class="channel-header-tabs"
      role="tablist"
    >
      <button
